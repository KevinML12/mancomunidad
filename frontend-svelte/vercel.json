{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "upgrade-insecure-requests; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
    ] }
  ],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://backend-eosin-omega-81.vercel.app/api/v1/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
