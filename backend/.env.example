# ── Base de datos ──────────────────────────────────────────────────
# DEV (por defecto, sin instalar nada — archivo local SQLite):
DATABASE_URL="file:./dev.db"

# PRODUCCIÓN: usar prisma/schema.production.prisma (no modificar el esquema SQLite).
# Consultar README.md para revisar y aplicar el SQL sobre PostgreSQL existente.
# DATABASE_URL="postgresql://usuario:password@host:5432/mfn_digital?sslmode=require"

# ── Autenticación JWT ──────────────────────────────────────────────
# Generar una clave real con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_CHARS"

# ── Servidor ───────────────────────────────────────────────────────
PORT=8080
CLIENT_URL="http://localhost:5173"

# Entrega de códigos al propietario de la cuenta (servicio de correo interno).
# POST HTTPS {correo, token, expira}; Authorization: Bearer RESET_DELIVERY_SECRET
# Sin configurar, la recuperación se deshabilita con respuesta 503.
RESET_DELIVERY_URL=""
RESET_DELIVERY_SECRET=""
