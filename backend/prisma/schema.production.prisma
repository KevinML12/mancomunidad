// Variante de producción de schema.prisma — misma estructura, provider
// "postgresql" en vez de "sqlite" (coincide con el stack del Cap. V).
// No se usa para el dev local (eso sigue en schema.prisma / SQLite, para
// no depender de un servicio corriendo en la máquina); esta es la que se
// usa para migrar y desplegar contra la base de datos real en la nube:
//   npm run migrate:production (sobre una base MFN existente y respaldada)
// Base nueva: npm run migrate:production:bootstrap.
// DATABASE_URL debe apuntar al proyecto de MFN en Supabase.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

model UnidadOrganizacional {
  id            Int                    @id @default(autoincrement())
  nombre        String
  unidadPadreId Int?
  unidadPadre   UnidadOrganizacional?  @relation("UnidadJerarquia", fields: [unidadPadreId], references: [id])
  hijas         UnidadOrganizacional[] @relation("UnidadJerarquia")
  puestos       Puesto[]
}

// categoria: A | B | C | D (Manual de Evaluación de Desempeño, Cap. IV)
model Puesto {
  id              Int                   @id @default(autoincrement())
  nombre          String
  categoria       String
  formaPago       String                @default("Mensual")
  unidadId        Int?
  unidad          UnidadOrganizacional? @relation(fields: [unidadId], references: [id])
  jefeInmediatoId Int?
  jefeInmediato   Puesto?               @relation("PuestoJerarquia", fields: [jefeInmediatoId], references: [id])
  subordinados    Puesto[]              @relation("PuestoJerarquia")
  colaboradores   Colaborador[]
  convocatorias   Convocatoria[]
}

// estado: Activo | Inactivo
model Colaborador {
  id               Int                          @id @default(autoincrement())
  nombre           String
  dpi              String?                      @unique
  puestoId         Int
  puesto           Puesto                       @relation(fields: [puestoId], references: [id])
  fechaIngreso     DateTime
  tipoContrato     String?
  estado           String                       @default("Activo")
  usuario          Usuario?
  contratos        Contrato[]
  evaluaciones     EvaluacionDesempeno[]        @relation("EvaluacionColaborador")
  evaluacionesHechas EvaluacionDesempeno[]      @relation("EvaluacionEvaluador")
  ausencias        SolicitudAusencia[]
  saldosVacaciones SaldoVacaciones[]
  faltas           FaltaDisciplinaria[]
  certificaciones  CertificacionCapacitacion[]
  createdAt        DateTime                     @default(now())
}

// Roles con permisos configurables — evolución del enum fijo de 5 roles
// de la propuesta original (Cap. I 1.9 Variables) hacia un catálogo de
// roles en base de datos, más fiel a la jerarquía real de la MFN.
// `permisos` = { modulos: string[], aprobar: string[], editar: string[] }
model Rol {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique
  nombre      String
  descripcion String?
  permisos    Json
  usuarios    Usuario[]
}

model Usuario {
  id             Int                 @id @default(autoincrement())
  correo         String              @unique
  sessionVersion Int @default(0)
  recuperaciones RecuperacionClave[]
  hashContrasena String
  rolId          Int
  rol            Rol                 @relation(fields: [rolId], references: [id])
  colaboradorId  Int?                @unique
  colaborador    Colaborador?        @relation(fields: [colaboradorId], references: [id])
  bitacora       BitacoraAuditoria[]
  createdAt      DateTime            @default(now())
}

// tipo: Interna | Externa | Mixta · estado: Abierta | Cerrada
model Convocatoria {
  id               Int         @id @default(autoincrement())
  puestoId         Int
  puesto           Puesto      @relation(fields: [puestoId], references: [id])
  tipo             String
  fechaPublicacion DateTime    @default(now())
  fechaCierre      DateTime
  requisitos       String?
  estado           String      @default("Abierta")
  candidatos       Candidato[]
}

model Candidato {
  id                  Int          @id @default(autoincrement())
  convocatoriaId      Int
  convocatoria        Convocatoria @relation(fields: [convocatoriaId], references: [id])
  nombre              String
  expedienteCompleto  Boolean      @default(false)
  puntajeCompetencias Float?
  puntajeExperiencia  Float?
  puntajeEntrevista   Float?
  puntajeReferencias  Float?
  puntajeTotal        Float?
  createdAt           DateTime     @default(now())
}

// tipo: 2 meses | 6 meses | 1 año | Por obra
model Contrato {
  id                       Int         @id @default(autoincrement())
  colaboradorId            Int
  colaborador              Colaborador @relation(fields: [colaboradorId], references: [id])
  tipo                     String
  fechaInicio              DateTime
  fechaFin                 DateTime?
  fechaRegistroContraloria DateTime?
  createdAt                DateTime    @default(now())
}

// resultado: Sobresaliente | Bueno | Regular | Deficiente | Pendiente
model EvaluacionDesempeno {
  id            Int                @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador        @relation("EvaluacionColaborador", fields: [colaboradorId], references: [id])
  evaluadorId   Int
  evaluador     Colaborador        @relation("EvaluacionEvaluador", fields: [evaluadorId], references: [id])
  periodo       String
  resultado     String?
  fecha         DateTime?
  factores      EvaluacionFactor[]
  planMejora    PlanMejora?
  createdAt     DateTime           @default(now())
}

model EvaluacionFactor {
  id           Int                 @id @default(autoincrement())
  evaluacionId Int
  evaluacion   EvaluacionDesempeno @relation(fields: [evaluacionId], references: [id])
  factor       Int
  nombreFactor String
  calificacion String?
}

model PlanMejora {
  id           Int                 @id @default(autoincrement())
  evaluacionId Int                 @unique
  evaluacion   EvaluacionDesempeno @relation(fields: [evaluacionId], references: [id])
  fechaInicio  DateTime            @default(now())
  fechaLimite  DateTime
  estado       String              @default("Activo")
}

// tipo: Vacaciones | Permiso | Licencia · estado: Pendiente | Aprobado | Rechazado
model SolicitudAusencia {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  tipo          String
  desde         DateTime
  hasta         DateTime
  motivo        String?
  estado        String      @default("Pendiente")
  aprobadorId   Int?
  createdAt     DateTime    @default(now())
}

model SaldoVacaciones {
  id              Int         @id @default(autoincrement())
  colaboradorId   Int
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  anio            Int
  diasDisponibles Int
  diasUsados      Int         @default(0)

  @@unique([colaboradorId, anio])
}

// tipo: Leve | Grave
model FaltaDisciplinaria {
  id              Int      @id @default(autoincrement())
  colaboradorId   Int
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  tipo            String
  descripcion     String
  fecha           DateTime @default(now())
  registradoPorId Int?
  sancion         Sancion?
}

// tipo: Verbal | Escrita | Suspension
model Sancion {
  id             Int                @id @default(autoincrement())
  faltaId        Int                @unique
  falta          FaltaDisciplinaria @relation(fields: [faltaId], references: [id])
  tipo           String
  fechaAudiencia DateTime?
  resultado      String?
  resueltoPorId  Int?
}

model Capacitacion {
  id                Int                          @id @default(autoincrement())
  nombreHerramienta String
  fecha             DateTime?
  convocadaPorId    Int?
  certificaciones   CertificacionCapacitacion[]
}

model CertificacionCapacitacion {
  id             Int          @id @default(autoincrement())
  capacitacionId Int
  capacitacion   Capacitacion @relation(fields: [capacitacionId], references: [id])
  colaboradorId  Int
  colaborador    Colaborador  @relation(fields: [colaboradorId], references: [id])
  firmado        Boolean      @default(false)
  fecha          DateTime?

  @@unique([capacitacionId, colaboradorId])
}

model BitacoraAuditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  accion    String
  entidad   String?
  entidadId Int?
  antesHash String?
  despuesHash String?
  fecha     DateTime @default(now())
}

// ==========================================
// MÓDULO 1: PROYECTOS INTERMUNICIPALES
// ==========================================

model Proyecto {
  municipio String?
  id                     Int                  @id @default(autoincrement())
  nombre                 String
  agenciaFinanciadora    String
  fechaInicioPlanificada DateTime
  fechaFinPlanificada    DateTime?
  presupuestoMunicipal   Float                @default(0)
  presupuestoCooperacion Float                @default(0)
  estado                 String               @default("Planificación") // Planificación, Ejecución, Finalizado
  porcentajeAvanceFisico Float                @default(0)
  evidencias             EvidenciaProyecto[]
  createdAt              DateTime             @default(now())
}

model EvidenciaProyecto {
  contenido String?
  tipoMime String?
  sha256 String?
  id           Int      @id @default(autoincrement())
  proyectoId   Int
  proyecto     Proyecto @relation(fields: [proyectoId], references: [id])
  urlArchivo   String
  latitud      Float?
  longitud     Float?
  descripcion  String?
  fechaCaptura DateTime @default(now())
  cargadoPorId Int?     // referencia a Usuario
}

// ==========================================
// MÓDULO 2: PLAN DE MEJORAS (ARC)
// ==========================================

model TareaARC {
  id              Int       @id @default(autoincrement())
  codigo          String    @unique
  titulo          String
  descripcion     String
  dimension       String    // Planificación y Monitoreo | Gestión de Proyectos e Inversión | Probidad, Transparencia y Eficiencia
  prioridad       String    @default("Media") // Alta | Media | Baja
  estado          String    @default("Pendiente") // Pendiente | En Proceso | En Revisión | Finalizado
  municipio       String?   @default("Regional")
  responsable     String
  fechaLimite     DateTime
  fechaFinalizada DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// MÓDULO 3: CONTROL FINANCIERO Y CUOTAS
// ==========================================

model TransaccionFinanciera {
  id                Int      @id @default(autoincrement())
  codigo            String   @unique
  tipo              String   // Ingreso | Egreso
  cuentaBancaria    String   // Fondos Públicos | Cooperación Internacional
  categoria         String   // Cuota Ordinaria | Cuota Extraordinaria | Caja Chica | Operativo | Donación
  municipio         String?  // San Pedro Soloma, Santa Eulalia, etc.
  monto             Float
  comprobanteTipo   String   // Recibo CGC 63-A2 | Factura SAT FEL | Recibo SAT
  comprobanteNumero String
  urlComprobante    String?  // Evidencia obligatoria en caja chica
  descripcion       String
  fecha             DateTime @default(now())
  createdAt         DateTime @default(now())
}

// ==========================================
// MÓDULO 4: GOBERNANZA Y ACTAS
// ==========================================

model ActaAsamblea {
  id              Int                 @id @default(autoincrement())
  numeroActa      String              @unique
  numeroSesion    Int
  tipoSesion      String              @default("Ordinaria")
  fecha           DateTime
  municipioSede   String
  lugarReunion    String?
  libroCGCFolio   String
  urlPdfEscaneado String?
  acuerdos        AcuerdoGobernanza[]
  createdAt       DateTime            @default(now())
}

model AcuerdoGobernanza {
  id                Int          @id @default(autoincrement())
  codigo            String       @unique
  actaId            Int
  acta              ActaAsamblea @relation(fields: [actaId], references: [id])
  titulo            String
  descripcion       String
  responsable       String
  fechaCumplimiento DateTime?
  estado            String       @default("En Proceso") // Cumplido | En Proceso | Pendiente
  evidenciaUrl      String?
  createdAt         DateTime     @default(now())
}

// ==========================================
// MÓDULO 5: ALIANZAS Y CONVENIOS
// ==========================================

model ConvenioInstitucional {
  id                Int      @id @default(autoincrement())
  codigo            String   @unique
  nombre            String
  tipoOrganizacion  String   // Cooperación Internacional | Sector Público | ONG
  entidadCooperante String
  montoCooperacion  Float    @default(0)
  contrapartidaMFN  Float    @default(0)
  fechaSuscripcion  DateTime
  fechaVencimiento  DateTime
  estado            String   @default("Vigente") // Vigente | Próximo a Vencer | Vencido | En Renovación
  urlDocumento      String?
  coordinadorMFN    String
  createdAt         DateTime @default(now())
}

// ==========================================
// MÓDULO 6: ESTADÍSTICAS ASH (AGUA Y SANEAMIENTO)
// ==========================================

model CensoComunitarioASH {
  id                    Int      @id @default(autoincrement())
  codigo                String   @unique
  municipio             String
  comunidad             String
  viviendasTotales      Int
  viviendasConAgua      Int
  sistemaCloracion      Boolean  @default(false)
  ppmCloroResidual      Float    @default(0)
  viviendasConSaneamiento Int
  fechaLevantamiento    DateTime @default(now())
  tecnicoResponsable    String
  createdAt             DateTime @default(now())
}

// ==========================================
// MÓDULO 7: PORTAL DE TRANSPARENCIA (RF5)
// ==========================================

model PublicacionTransparencia {
  id               Int      @id @default(autoincrement())
  codigo           String   @unique
  tipo             String   // Proyecto | Acta | Estadística | Finanzas
  titulo           String
  resumen          String
  referenciaId     Int?
  visibilidad      Boolean  @default(true)
  fechaPublicacion DateTime @default(now())
  autorizadoPor    String   @default("Gerencia Ejecutiva")
  createdAt        DateTime @default(now())
}

model RecuperacionClave {
 id Int @id @default(autoincrement())
 usuarioId Int
 usuario Usuario @relation(fields: [usuarioId], references: [id])
 tokenHash String @unique
 expira DateTime
 usado Boolean @default(false)
}
model PuntoControlIntegridad {
 id Int @id @default(autoincrement())
 rootHash String
 snapshot Json
 auditoriaId Int
 usuarioId Int
 fecha DateTime @default(now())
}
