# ── Base de datos ──────────────────────────────────────────────────
# DEV (por defecto, sin instalar nada — archivo local SQLite):
DATABASE_URL="file:./dev.db"

# PRODUCCIÓN (coincide con el stack del Capítulo V — PostgreSQL):
# 1. Cambiar prisma/schema.prisma → datasource db { provider = "postgresql" ... }
# 2. Crear un proyecto gratis en https://neon.tech o https://supabase.com
# 3. Pegar aquí la cadena de conexión que te den, ej.:
# DATABASE_URL="postgresql://usuario:password@host:5432/sirh_mfn?sslmode=require"

# ── Autenticación JWT ──────────────────────────────────────────────
# Generar una clave real con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_CHARS"

# ── Servidor ───────────────────────────────────────────────────────
PORT=8080
CLIENT_URL="http://localhost:5173"
